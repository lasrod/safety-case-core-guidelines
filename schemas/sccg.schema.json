{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sccg_version",
    "document",
    "source_policy",
    "method_application_guidance",
    "id_scheme",
    "required_guideline_sections"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "sccg_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "copyright", "license", "purpose"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "copyright": { "type": "string", "minLength": 1 },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "url"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 }
          }
        },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "method_application_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "recommendations"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "recommendation"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "recommendation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "id_scheme": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "meaning"],
        "properties": {
          "prefix": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_guideline_sections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}