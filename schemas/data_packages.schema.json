{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG data package registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_packages"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "data_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "description", "required_fields", "optional_fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "optional_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}