{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG pre-check registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prechecks"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "prechecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "related_guideline_ids",
          "expected_data",
          "result_type",
          "description",
          "fires_when",
          "interpretation"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "related_guideline_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" }
          },
          "expected_data": {
            "description": "Data packages the check needs. The selected-element package names the element the check runs on.",
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          },
          "result_type": { "type": "string", "enum": ["boolean_candidate", "missing_fields"] },
          "description": { "type": "string", "minLength": 1 },
          "fires_when": {
            "description": "The condition under which the check reports a candidate, precise enough that two tools implement the same check. A tool that answers a different question must not report this pre-check id.",
            "type": "string",
            "minLength": 1
          },
          "interpretation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
