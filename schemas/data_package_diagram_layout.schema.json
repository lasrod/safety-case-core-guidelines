{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG data package diagram layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_profile_diagram_layout"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "review_profile_diagram_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "center",
        "package_positions"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "center": {
          "$ref": "#/definitions/node"
        },
        "package_positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/positionedNode"
          }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "positionedNode": {
      "allOf": [
        {
          "$ref": "#/definitions/node"
        },
        {
          "required": [
            "id",
            "x",
            "y"
          ]
        }
      ]
    }
  }
}
