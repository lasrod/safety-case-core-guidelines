{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG authoring guidance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authoring_guidance"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "authoring_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "usage", "core_rules"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "core_rules": {
          "description": "Ordered subset of guidelines for delivery at authoring time. Every category must be represented, so that no guideline family is invisible to a tool that carries only this set.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
