{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG AI rule export row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sccg_version",
    "id",
    "category",
    "rule_id",
    "category_id",
    "title",
    "statement",
    "short_rule",
    "rationale",
    "review_prompts",
    "examples",
    "references",
    "distinguish_from",
    "tool",
    "reference_source_ids",
    "review_profile_ids",
    "data_package_ids"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "sccg_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" },
    "category": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "rule_id": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" },
    "category_id": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "short_rule": { "type": "string", "minLength": 1, "maxLength": 140 },
    "rationale": { "type": "string", "minLength": 1 },
    "review_prompts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "examples": { "type": "object" },
    "references": { "type": "array" },
    "distinguish_from": {
      "description": "Neighbouring guidelines and when to cite them instead. Empty when none is published.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tool": { "type": "object" },
    "reference_source_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review_profile_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "data_package_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}