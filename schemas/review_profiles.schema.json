{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG review profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selectable_elements", "review_profiles"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "selectable_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element", "notation", "element_role", "basis"],
        "properties": {
          "element": { "type": "string", "minLength": 1 },
          "notation": { "type": "string", "enum": ["GSN", "CAE"] },
          "element_role": {
            "description": "Notation-neutral role of this element. A tool whose internal model is neither GSN nor CAE maps its own element types onto this value, and presents the element name of the notation its users see.",
            "type": "string",
            "enum": ["claim", "strategy", "evidence", "context", "assumption", "justification", "challenge"]
          },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "description",
          "applies_to",
          "guideline_ids",
          "required_data",
          "optional_data",
          "data_rationale"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "guideline_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" }
          },
          "required_data": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          },
          "optional_data": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          },
          "data_rationale": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
              "required": {
                "type": "array",
                "items": { "$ref": "#/definitions/data_rationale_entry" }
              },
              "optional": {
                "type": "array",
                "items": { "$ref": "#/definitions/data_rationale_entry" }
              }
            }
          },
          "when_absent": {
            "description": "What a review may still conclude when a required data package cannot be supplied. Present for required packages a tool may legitimately be unable to build.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "unassessable_guideline_ids", "statement"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "unassessable_guideline_ids": {
                  "description": "Guidelines of this profile that cannot be judged without the package. Must be a subset of the profile's guideline_ids.",
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" }
                },
                "statement": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "data_rationale_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
