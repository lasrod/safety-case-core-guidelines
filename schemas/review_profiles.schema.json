{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCCG review profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selectable_elements", "review_profiles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "selectable_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["element", "notation", "basis"],
        "properties": {
          "element": { "type": "string", "minLength": 1 },
          "notation": { "type": "string", "enum": ["GSN", "CAE"] },
          "basis": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "description",
          "applies_to",
          "guideline_ids",
          "required_data",
          "optional_data",
          "data_rationale"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "guideline_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]{2}\\.\\d+$" }
          },
          "required_data": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          },
          "optional_data": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          },
          "data_rationale": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "optional"],
            "properties": {
              "required": {
                "type": "array",
                "items": { "$ref": "#/definitions/data_rationale_entry" }
              },
              "optional": {
                "type": "array",
                "items": { "$ref": "#/definitions/data_rationale_entry" }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "data_rationale_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}