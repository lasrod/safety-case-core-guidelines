{
  "availability_states": [
    {
      "display_name": "Available",
      "id": "available",
      "meaning": "The package is supplied and carries the data the profile expects."
    },
    {
      "display_name": "Not implemented",
      "id": "not_implemented",
      "meaning": "The tool has no source for this package at all."
    },
    {
      "display_name": "Empty",
      "id": "empty",
      "meaning": "The tool has a source for this package and this case has nothing in it."
    },
    {
      "display_name": "Withheld",
      "id": "withheld",
      "meaning": "The data exists and was deliberately not shared with the review, for example by a consent or confidentiality decision."
    }
